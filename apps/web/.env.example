DEEPL_API_KEY=
# Phase 6 — Neon Postgres (direct connection string, sslmode=require)
# Setup guide: docs/neon-setup.md — then: npm run db:migrate
DATABASE_URL=
RATE_LIMIT_PER_MIN=20
CEDICT_DB_PATH=
# Import script only: prefix the command, e.g. CEDICT_FETCH=1 npm run import-cedict.
# This is not read from Next.js .env.local.
# CEDICT_FETCH=1
OPENAI_API_KEY=
NATIVE_ALT_MODEL=gpt-4o-mini

# Phase 6 — Auth.js (Google OAuth)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Phase 3+ TTS uses the browser Web Speech API (no server key).
# Optional later: Google Cloud TTS
# GOOGLE_APPLICATION_CREDENTIALS=

# Optional: hide phrasebook UI later without migrations
# NEXT_PUBLIC_ENABLE_PHRASEBOOK=true
